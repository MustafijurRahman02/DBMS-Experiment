-- ============================================================
-- EXPERIMENT 2
-- ER DIAGRAM TO RELATIONAL SCHEMA
-- E-Commerce Database
-- ============================================================

DROP DATABASE IF EXISTS ecommerce_db;
CREATE DATABASE ecommerce_db;
USE ecommerce_db;

-- ============================================================
-- 1. CUSTOMER
-- Composite attribute Name is decomposed into First_Name/Last_Name
-- ============================================================

CREATE TABLE customer (
    Customer_ID INT PRIMARY KEY,
    First_Name VARCHAR(50) NOT NULL,
    Last_Name VARCHAR(50) NOT NULL,
    Email VARCHAR(100) NOT NULL UNIQUE,
    Date_of_Birth DATE,
    Gender VARCHAR(20)
);

-- ============================================================
-- 2. CUSTOMER_PHONE
-- Multivalued attribute Phone_No
-- ============================================================

CREATE TABLE customer_phone (
    Customer_ID INT,
    Phone_No VARCHAR(20),
    PRIMARY KEY (Customer_ID, Phone_No),
    FOREIGN KEY (Customer_ID)
        REFERENCES customer(Customer_ID)
        ON DELETE CASCADE
);

-- ============================================================
-- 3. CATEGORY
-- ============================================================

CREATE TABLE category (
    Category_ID INT PRIMARY KEY,
    Category_Name VARCHAR(100) NOT NULL UNIQUE,
    Description VARCHAR(255)
);

-- ============================================================
-- 4. ADDRESS
-- CUSTOMER 1:N ADDRESS
-- ============================================================

CREATE TABLE address (
    Address_ID INT PRIMARY KEY,
    Customer_ID INT NOT NULL,
    House_No VARCHAR(20),
    Street VARCHAR(100),
    City VARCHAR(50),
    State VARCHAR(50),
    Pincode VARCHAR(10),
    Address_Type VARCHAR(30),
    FOREIGN KEY (Customer_ID)
        REFERENCES customer(Customer_ID)
        ON DELETE CASCADE
);

-- ============================================================
-- 5. PRODUCT
-- CATEGORY 1:N PRODUCT
-- SET NULL is used to demonstrate optional category reference.
-- ============================================================

CREATE TABLE product (
    Product_ID INT PRIMARY KEY,
    Product_Name VARCHAR(100) NOT NULL,
    Description VARCHAR(255),
    Price DECIMAL(12,2) NOT NULL,
    Stock_Quantity INT NOT NULL,
    Brand VARCHAR(100),
    Category_ID INT,
    FOREIGN KEY (Category_ID)
        REFERENCES category(Category_ID)
        ON DELETE SET NULL
);

-- ============================================================
-- 6. PRODUCT ISA SPECIALIZATION: ELECTRONICS
-- ============================================================

CREATE TABLE electronics (
    Product_ID INT PRIMARY KEY,
    Warranty_Period INT,
    Model_No VARCHAR(50),
    FOREIGN KEY (Product_ID)
        REFERENCES product(Product_ID)
        ON DELETE CASCADE
);

-- ============================================================
-- 7. PRODUCT ISA SPECIALIZATION: CLOTHING
-- ============================================================

CREATE TABLE clothing (
    Product_ID INT PRIMARY KEY,
    Size VARCHAR(20),
    Fabric VARCHAR(50),
    Color VARCHAR(30),
    FOREIGN KEY (Product_ID)
        REFERENCES product(Product_ID)
        ON DELETE CASCADE
);

-- ============================================================
-- 8. PRODUCT ISA SPECIALIZATION: GROCERY
-- ============================================================

CREATE TABLE grocery (
    Product_ID INT PRIMARY KEY,
    Expiry_Date DATE,
    Weight DECIMAL(10,2),
    FOREIGN KEY (Product_ID)
        REFERENCES product(Product_ID)
        ON DELETE CASCADE
);

-- ============================================================
-- 9. SELLER
-- ============================================================

CREATE TABLE seller (
    Seller_ID INT PRIMARY KEY,
    Seller_Name VARCHAR(100) NOT NULL,
    Email VARCHAR(100) NOT NULL UNIQUE,
    Phone VARCHAR(20) UNIQUE,
    GSTIN VARCHAR(30) UNIQUE,
    Business_Name VARCHAR(100)
);

-- ============================================================
-- 10. SELLS
-- PRODUCT M:N SELLER
-- Relationship attributes are stored here.
-- ============================================================

CREATE TABLE sells (
    Product_ID INT,
    Seller_ID INT,
    Selling_Price DECIMAL(12,2) NOT NULL,
    Seller_Stock INT NOT NULL,
    Seller_Rating DECIMAL(3,2),
    PRIMARY KEY (Product_ID, Seller_ID),
    FOREIGN KEY (Product_ID)
        REFERENCES product(Product_ID)
        ON DELETE CASCADE,
    FOREIGN KEY (Seller_ID)
        REFERENCES seller(Seller_ID)
        ON DELETE CASCADE
);

-- ============================================================
-- 11. ORDERS
-- CUSTOMER 1:N ORDER
-- ============================================================

CREATE TABLE orders (
    Order_ID INT PRIMARY KEY,
    Customer_ID INT NOT NULL,
    Order_Date DATE NOT NULL,
    Order_Status VARCHAR(30) NOT NULL,
    Total_Amount DECIMAL(12,2) NOT NULL,
    FOREIGN KEY (Customer_ID)
        REFERENCES customer(Customer_ID)
        ON DELETE CASCADE
);

-- ============================================================
-- 12. ORDER_ITEM
-- Weak entity identified by ORDER.
-- Composite primary key = (Order_ID, Product_ID)
-- ============================================================

CREATE TABLE order_item (
    Order_ID INT,
    Product_ID INT,
    Quantity INT NOT NULL,
    Unit_Price DECIMAL(12,2) NOT NULL,
    Discount DECIMAL(5,2) DEFAULT 0,
    Subtotal DECIMAL(12,2) NOT NULL,
    PRIMARY KEY (Order_ID, Product_ID),
    FOREIGN KEY (Order_ID)
        REFERENCES orders(Order_ID)
        ON DELETE CASCADE,
    FOREIGN KEY (Product_ID)
        REFERENCES product(Product_ID)
        ON DELETE CASCADE
);

-- ============================================================
-- 13. PAYMENT
-- ORDER 1:1 PAYMENT
-- UNIQUE(Order_ID) enforces one payment per order.
-- ============================================================

CREATE TABLE payment (
    Payment_ID INT PRIMARY KEY,
    Order_ID INT NOT NULL UNIQUE,
    Payment_Date DATE NOT NULL,
    Amount DECIMAL(12,2) NOT NULL,
    Payment_Method VARCHAR(30) NOT NULL,
    Payment_Status VARCHAR(30) NOT NULL,
    Transaction_ID VARCHAR(100) UNIQUE,
    FOREIGN KEY (Order_ID)
        REFERENCES orders(Order_ID)
        ON DELETE CASCADE
);

-- ============================================================
-- 14. PAYMENT_UPI
-- Multivalued UPI attribute of PAYMENT
-- ============================================================

CREATE TABLE payment_upi (
    Payment_ID INT,
    UPI_ID VARCHAR(100),
    PRIMARY KEY (Payment_ID, UPI_ID),
    FOREIGN KEY (Payment_ID)
        REFERENCES payment(Payment_ID)
        ON DELETE CASCADE
);

-- ============================================================
-- 15. DELIVERY
-- ORDER 1:1 DELIVERY
-- UNIQUE(Order_ID) enforces one delivery per order.
-- ============================================================

CREATE TABLE delivery (
    Delivery_ID INT PRIMARY KEY,
    Order_ID INT NOT NULL UNIQUE,
    Delivery_Date DATE,
    Delivery_Status VARCHAR(30),
    Tracking_ID VARCHAR(100) UNIQUE,
    Delivery_Charges DECIMAL(10,2),
    FOREIGN KEY (Order_ID)
        REFERENCES orders(Order_ID)
        ON DELETE CASCADE
);

